# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database (Neon / PostgreSQL)
# ---------------------------------------------------------------------------
# Neon: Dashboard -> your project -> Connection string (include ?sslmode=require).
# Local dev: postgres://USER@127.0.0.1:5432/studypy
DATABASE_URL=""

# Max pooled connections. Neon's free tier is small — keep this modest.
DATABASE_POOL_MAX="10"

# ---------------------------------------------------------------------------
# Firebase (browser)
# ---------------------------------------------------------------------------
# From Firebase console -> Project settings -> Your apps -> SDK setup & config.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Firestore database id. Leave as "(default)" unless you created a named one.
VITE_FIREBASE_DATABASE_ID="(default)"

# ---------------------------------------------------------------------------
# Firebase (server)
# ---------------------------------------------------------------------------
# Must be the same project that issues the browser's ID tokens.
FIREBASE_PROJECT_ID=""

# Optional JSON-encoded service account. Supplying it enables the Admin SDK
# verification path. Never expose this to the browser or commit it.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ---------------------------------------------------------------------------
# Gemini (AI mentor + daily challenge generation)
# ---------------------------------------------------------------------------
# Read only by the server; the browser talks to the /api/mentor/* proxy.
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Public URL of the deployment. Used for self-referential links and CORS.
APP_URL=""

# Comma-separated origins allowed to reach the realtime server.
CORS_ORIGINS="http://localhost:3000"

PORT="3000"
HOST="127.0.0.1"
